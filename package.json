{
  "name": "rapport-techniciens",
  "version": "1.0.0",
  "private": true,
  "description": "Application web mobile (PWA) de saisie des rapports d'intervention des techniciens",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "create-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ejs": "3.1.10",
    "express": "5.3.0",
    "multer": "2.4.0"
  }
}
